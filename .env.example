# Comma-separated list of browser origins allowed to call the API (CORS).
# The deployed frontend is a static export, so all CMS calls are cross-origin
# from the visitor browser. *.vercel.app preview domains and any amxr.site
# host are always allowed, so they need not be listed here.
CORS_ORIGINS=https://nexus-properties.amxr.site,https://nexus-properties-lilac.vercel.app,http://localhost:3000
